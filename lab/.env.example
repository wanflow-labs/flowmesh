# Copy to lab/.env and fill in. lab/.env is not committed.
#
# Relay image for the lab's two DERP regions (a DERP server image; must accept --certmode=manual).
FLOWMESH_LAB_DERP_IMAGE=
# Control-server source tree, relative to lab/ (built for the host architecture by scripts/build-images.sh).
FLOWMESH_LAB_HEADSCALE_SRC=
# Reference client source tree for WanFlow-specific semantics (wm1), relative to lab/.
FLOWMESH_LAB_MESH_SRC=
