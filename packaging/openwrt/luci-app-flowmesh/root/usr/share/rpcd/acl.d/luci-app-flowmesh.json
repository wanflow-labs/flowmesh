{
	"luci-app-flowmesh": {
		"description": "Grant access to FlowMesh",
		"read": {
			"file": {
				"/usr/libexec/flowmesh-luci status": [ "exec" ],
				"/usr/libexec/flowmesh-luci logs": [ "exec" ],
				"/usr/libexec/flowmesh-luci exitstate": [ "exec" ],
				"/usr/libexec/flowmesh-luci netcheck": [ "exec" ],
				"/usr/libexec/flowmesh-luci ping *": [ "exec" ],
				"/usr/libexec/flowmesh-luci bugreport": [ "exec" ],
				"/usr/libexec/flowmesh-luci regions": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "flowmesh" ]
		},
		"write": {
			"file": {
				"/usr/libexec/flowmesh-luci up *": [ "exec" ],
				"/usr/libexec/flowmesh-luci reconnect": [ "exec" ],
				"/usr/libexec/flowmesh-luci down": [ "exec" ],
				"/usr/libexec/flowmesh-luci logout": [ "exec" ],
				"/usr/libexec/flowmesh-luci apply": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"uci": [ "commit", "revert" ]
			},
			"uci": [ "flowmesh" ]
		}
	}
}
