#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# flowmeshd under procd. /etc/config/flowmesh holds the user's intent only; the login and the node
# identity live in the state directory, which is on flash (/var is a tmpfs on OpenWrt) and in the
# sysupgrade keep list.
#
# No service_triggers on purpose: reloading on WAN/interface events makes a loop, because bringing
# up the mesh interface and its routes is itself such an event. Settings reach the daemon through
# `reload`, which never restarts it.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/flowmeshd
STATE_DIR=/etc/flowmesh
TUN=flowmesh0
SOCKET=/var/run/flowmesh/flowmeshd.sock   # the CLI's and daemon's default
PREFS=/usr/share/flowmesh/prefs.sh   # UCI -> flags, shared with the LuCI helper
WATCH=/usr/libexec/flowmesh-watch     # exit node fallback, mesh names for the LAN

flowmesh_enabled() {
	local enabled
	config_load flowmesh
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

# Push the UCI intent to the daemon (waits up to $1 seconds for it to answer), holding the apply
# lock (FLOWMESH_APPLY_LOCK_WAIT: how long to wait for it, default 60 s; the LuCI helper's apply
# must stay within rpcd's time limit).
apply_prefs() {
	local rc
	. "$PREFS"
	flowmesh_apply_lock "${FLOWMESH_APPLY_LOCK_WAIT:-60}" || return 1
	apply_prefs_locked "$@"
	rc=$?
	flowmesh_apply_unlock
	return $rc
}

apply_prefs_locked() {
	local wait=${1:-10} err
	flowmesh_load_prefs
	# fw3 flushes the whole nat table on every firewall reload, and with it the SNAT the daemon puts
	# in place for an exit node (it notices within 5 s). So when an exit node is to be used, the
	# firewall's part of that goes first: the firewall reloads before the daemon has its SNAT, and the
	# apply at the end has nothing left to change unless the exit node is refused.
	[ -n "$FM_EXIT_IP" ] && flowmesh_apply_fw early
	# Retried until the daemon answers: right after a (re)start the socket may be missing or still
	# the previous process's.
	until err=$(flowmesh_cli set 2>&1); do
		case "$err" in
		*"cannot reach flowmeshd"*) ;;
		*"no node found in netmap with IP"* | *"is not advertising an exit node"*)
			# The chosen exit node left the mesh or stopped offering itself: the other settings
			# still apply, and no exit node is used (not an older one either). With the kill
			# switch the LAN gets no Internet at all (flowmesh_apply_fw blocks lan -> wan) until
			# an apply succeeds; without it the LAN uses the local uplink.
			[ -n "$FM_EXIT_IP" ] || {
				echo "flowmesh: could not apply settings: $err" >&2
				return 1
			}
			echo "flowmesh: exit node $FM_EXIT_IP cannot be used: $err" >&2
			[ "$FM_KILL_SWITCH" = 1 ] && FM_EXIT_BLOCK=1
			FM_EXIT_IP=
			continue
			;;
		*) echo "flowmesh: could not apply settings: $err" >&2; return 1 ;;
		esac
		[ "$wait" -gt 0 ] || { echo "$err" >&2; return 1; }
		sleep 1
		wait=$((wait - 1))
	done
	flowmesh_apply_fw
}

start_service() {
	flowmesh_enabled || return 0
	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$PROG" --state-dir "$STATE_DIR" --tun "$TUN"
	procd_set_param respawn
	# The daemon removes its routes and forwarding rules on SIGTERM; give it time to.
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The watcher: probes the exit node in use (kill switch fallback) and keeps dnsmasq forwarding the
	# mesh's names; it undoes its dnsmasq entries on SIGTERM.
	procd_open_instance watch
	procd_set_param command "$WATCH"
	procd_set_param respawn
	procd_set_param term_timeout 15
	procd_close_instance
}

service_started() {
	# Boot and `start` must not wait for the daemon: apply the settings in the background.
	[ -n "$FLOWMESH_SYNC_APPLY" ] && return 0
	flowmesh_enabled || return 0
	( apply_prefs 30 2>&1 | logger -t flowmesh ) &
}

# With the daemon stopped the LAN uses the local uplink, IPv6 included. The watcher removes its
# dnsmasq entries when it is stopped; `cleanup` again, in case it was not running.
service_stopped() {
	/usr/libexec/flowmesh-fw exit-v6-block-off exit-kill-off
	"$WATCH" cleanup
}

reload_service() {
	if ! flowmesh_enabled; then
		stop
		return 0
	fi
	# Starts the daemon if it is not running; an unchanged running instance is left alone.
	FLOWMESH_SYNC_APPLY=1
	start
	FLOWMESH_SYNC_APPLY=
	apply_prefs 10
}
