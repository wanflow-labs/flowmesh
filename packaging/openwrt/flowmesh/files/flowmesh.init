#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# flowmeshd under procd. /etc/config/flowmesh holds the user's intent only; the login and the node
# identity live in the state directory, which is on flash (/var is a tmpfs on OpenWrt) and in the
# sysupgrade keep list.
#
# No service_triggers on purpose: reloading on WAN/interface events makes a loop, because bringing
# up the mesh interface and its routes is itself such an event. Settings reach the daemon through
# `reload`, which never restarts it.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/flowmeshd
CLI=/usr/bin/flowmesh
STATE_DIR=/etc/flowmesh
TUN=flowmesh0
SOCKET=/var/run/flowmesh/flowmeshd.sock   # the CLI's and daemon's default

flowmesh_enabled() {
	local enabled
	config_load flowmesh
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ]
}

# IPv4 networks of the lan interface (e.g. 192.168.1.0/24), from netifd.
lan_networks() {
	local status i=0 addr mask n a b c d
	status=$(ubus call network.interface.lan status 2>/dev/null) || return 0
	while :; do
		addr=$(echo "$status" | jsonfilter -e "@['ipv4-address'][$i].address" 2>/dev/null)
		mask=$(echo "$status" | jsonfilter -e "@['ipv4-address'][$i].mask" 2>/dev/null)
		[ -n "$addr" ] && [ -n "$mask" ] || break
		local IFS=.
		set -- $addr
		unset IFS
		a=$1 b=$2 c=$3 d=$4
		n=$(( ((a << 24) | (b << 16) | (c << 8) | d) & ((0xffffffff << (32 - mask)) & 0xffffffff) ))
		echo "$(( (n >> 24) & 255 )).$(( (n >> 16) & 255 )).$(( (n >> 8) & 255 )).$(( n & 255 ))/$mask"
		i=$((i + 1))
	done
}

append_route() {
	routes="${routes:+$routes,}$1"
}

# Push the UCI intent to the daemon (waits up to $1 seconds for it to answer).
apply_prefs() {
	local wait=${1:-10} hostname advertise_lan exit_node accept_routes routes="" n
	config_load flowmesh
	config_get hostname main hostname
	config_get_bool advertise_lan main advertise_lan 0
	config_get_bool exit_node main exit_node 0
	config_get_bool accept_routes main accept_routes 0
	# The daemon does not fall back to the system hostname itself, and a node without a name is
	# refused by the control server.
	[ -n "$hostname" ] || hostname=$(cat /proc/sys/kernel/hostname)
	if [ "$advertise_lan" = 1 ]; then
		config_list_foreach main lan_routes append_route
		if [ -z "$routes" ]; then
			for n in $(lan_networks); do append_route "$n"; done
		fi
	fi

	# Retried until the daemon answers: right after a (re)start the socket may be missing or still
	# the previous process's. The router's DNS belongs to dnsmasq: never let the daemon rewrite
	# resolv.conf.
	local err
	until err=$("$CLI" set --accept-dns=false --hostname="$hostname" --accept-routes="$accept_routes" \
		--advertise-routes="$routes" --advertise-exit-node="$exit_node" 2>&1); do
		case "$err" in
		*"cannot reach flowmeshd"*) ;;
		*) echo "flowmesh: could not apply settings: $err" >&2; return 1 ;;
		esac
		[ "$wait" -gt 0 ] || { echo "$err" >&2; return 1; }
		sleep 1
		wait=$((wait - 1))
	done

	if [ "$exit_node" = 1 ]; then
		/usr/libexec/flowmesh-fw exitnode-on
	else
		/usr/libexec/flowmesh-fw exitnode-off
	fi
}

start_service() {
	flowmesh_enabled || return 0
	mkdir -p "$STATE_DIR"
	chmod 0700 "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$PROG" --state-dir "$STATE_DIR" --tun "$TUN"
	procd_set_param respawn
	# The daemon removes its routes and forwarding rules on SIGTERM; give it time to.
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	# Boot and `start` must not wait for the daemon: apply the settings in the background.
	[ -n "$FLOWMESH_SYNC_APPLY" ] && return 0
	flowmesh_enabled || return 0
	( apply_prefs 30 2>&1 | logger -t flowmesh ) &
}

reload_service() {
	if ! flowmesh_enabled; then
		stop
		return 0
	fi
	# Starts the daemon if it is not running; an unchanged running instance is left alone.
	FLOWMESH_SYNC_APPLY=1
	start
	FLOWMESH_SYNC_APPLY=
	apply_prefs 10
}
