# The user's intent; the login and identity are kept by flowmeshd in /etc/flowmesh.
# Applied with `/etc/init.d/flowmesh reload` (the daemon is not restarted).
config flowmesh 'main'
	# Run the daemon.
	option enabled '1'
	# Name in the mesh; empty: the system hostname.
	option hostname ''
	# Share the LAN with the mesh (an administrator approves the routes in the console).
	option advertise_lan '0'
	# Networks to share; none listed: the networks of the lan interface.
	#list lan_routes '192.168.1.0/24'
	# Offer this router as an exit node (also needs approval).
	option exit_node '0'
	# Send the LAN's Internet traffic through this exit node (its mesh IPv4 address); empty: none.
	# Not together with exit_node. The router's own traffic stays on the local uplink, and the
	# LAN's IPv6 is kept off the local uplink meanwhile.
	#option use_exit_node '100.64.0.2'
	# Kill switch: while that exit node is offline the LAN has no Internet ('1', the default when
	# unset); '0': it uses the local uplink until the exit node is back.
	#option kill_switch '1'
	# LAN hosts can use mesh names: the router's DNS hands mesh domains to FlowMesh ('1', the
	# default when unset).
	#option lan_dns '1'
	# Use routes other mesh nodes share.
	option accept_routes '0'
