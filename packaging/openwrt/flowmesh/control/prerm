#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Removal only (opkg does not run prerm on upgrade; apk runs pre-deinstall only on removal).
# The state directory /etc/flowmesh (the node's identity) is kept, like a modified conffile.
[ "$IPKG_NO_SCRIPT" = 1 ] && exit 0
[ -n "$IPKG_INSTROOT" ] && exit 0
/etc/init.d/flowmesh stop
/etc/init.d/flowmesh disable
# The daemon removes its routes and forwarding rules on the way out; wait for it.
i=0
while pidof flowmeshd >/dev/null && [ "$i" -lt 20 ]; do
	sleep 1
	i=$((i + 1))
done
/usr/libexec/flowmesh-fw remove
exit 0
